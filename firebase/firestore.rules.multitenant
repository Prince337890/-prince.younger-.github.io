rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Forward OS — Multi-Tenant Rules (Lite)
    // Isolation key: every workspace doc carries an `orgId`. A user's
    // orgId/role live on their own users/{uid} doc. We resolve them with
    // get() at evaluation time. PUBLISH ONLY AFTER the data backfill has
    // stamped every existing doc with an orgId (use Workspaces -> One-Time
    // Data Migration). Before that, these rules will block reads.
    // ============================================================

    // ---- helpers ----
    function signedIn() { return request.auth != null; }

    // Super-admin (you) — full cross-workspace access; provisions workspaces.
    function isSuper() {
      return signedIn() && request.auth.token.email in ['prince.younger3@gmail.com'];
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myOrg()  { return myUser().orgId; }
    function myRole() { return myUser().role; }

    // A dispatcher = the workspace owner/operator (role 'admin'), or you.
    function isDispatcher() { return signedIn() && (isSuper() || myRole() == 'admin'); }

    // Does an existing doc belong to the caller's workspace?
    function ownDoc(res)   { return isSuper() || (isDispatcher() && res.data.orgId == myOrg()); }
    // Is an incoming write stamped with the caller's workspace?
    function ownNew(req)   { return isSuper() || (isDispatcher() && req.resource.data.orgId == myOrg()); }
    // Any signed-in member of the same workspace (dispatcher OR their drivers).
    function memberRead(res) { return isSuper() || (signedIn() && res.data.orgId == myOrg()); }
    function memberNew(req)   { return isSuper() || (signedIn() && req.resource.data.orgId == myOrg()); }

    // ---- user accounts ----
    // Self-write covers a carrier's own availability, vipRequested,
    // credentials, CPM inputs, W-9, profile, etc. (all on their user doc).
    // A dispatcher can read/manage the user docs inside their own workspace.
    //
    // SECURITY: role / orgId / approved are AUTHORIZATION fields. A user must
    // never be able to change their OWN authorization — otherwise any carrier
    // (who already holds a valid auth token) could set role:'admin' +
    // orgId:'<any workspace>' on themselves and take over that workspace.
    // Those three fields are set only by a dispatcher/super at provisioning.
    // (Writing an unchanged value is not a "change", so the app's login-time
    //  merge of approved:true on an already-approved doc still passes.)
    match /users/{uid} {
      allow read:   if request.auth.uid == uid || isSuper()
                    || (isDispatcher() && resource.data.orgId == myOrg());
      // Provisioning only — never self-create (blocks a fresh Google/email
      // sign-in from minting itself an admin user doc).
      allow create: if ownNew(request);
      allow update: if isSuper()
                    || (isDispatcher() && resource.data.orgId == myOrg())
                    || (request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['role', 'orgId', 'approved']));
      allow delete: if ownDoc(resource);
    }

    // ---- loads (driver owns by uid; dispatcher owns by orgId) ----
    // The dispatcher who owns the load can edit anything. The linked driver
    // can only touch the fields their own screens write — status, offer
    // response, RateCon signature, delivery debrief, detention, and the proof
    // package. They must NOT be able to rewrite gross_pay / feePct / orgId,
    // which drive invoicing and tenant scope.
    function driverLoadKeys() {
      return ['status', 'offerStatus', 'offerRespondedAt', 'declineReason',
              'rateConSigned', 'deliveryReport', 'detention', 'docs', 'steps',
              'showerRequested', 'showerRequestedAt'];
    }
    match /loads/{id} {
      allow read:   if (signedIn() && resource.data.uid == request.auth.uid) || ownDoc(resource);
      allow create: if ownNew(request);
      allow update: if ownDoc(resource)
                    || (signedIn() && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(driverLoadKeys()));
      allow delete: if ownDoc(resource);
    }

    // ---- carriers ----
    // Dispatcher manages everything in their workspace. The linked driver can
    // read their own profile and update ONLY their availability.
    match /carriers/{id} {
      allow read:   if (signedIn() && resource.data.linkedDriverUid == request.auth.uid) || ownDoc(resource);
      allow create: if ownNew(request);
      allow delete: if ownDoc(resource);
      allow update: if ownDoc(resource)
        || (signedIn()
            && resource.data.linkedDriverUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability']));
    }

    // ---- schedule events (each user owns their own) ----
    match /schedule_events/{id} {
      allow read:           if isDispatcher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create:         if isDispatcher() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isDispatcher() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---- compliance (one doc per driver uid) ----
    // The carrier owns their CDL/medical/insurance dates and can maintain them
    // themselves; their dispatcher can also edit (via "view as"). The doc must
    // carry the caller's own orgId on create.
    match /compliance/{uid} {
      allow read:  if request.auth.uid == uid || ownDoc(resource);
      allow write: if request.auth.uid == uid || ownNew(request) || ownDoc(resource);
    }

    // ---- expenses (dispatcher dispatch-fee / expense tracker) ----
    match /expenses/{id} {
      allow read:   if ownDoc(resource);
      allow create: if ownNew(request);
      allow update, delete: if ownDoc(resource);
    }

    // ---- lane intel ----
    // Any workspace member can read and ADD entries (drivers post delivery
    // debriefs that surface in Facility & Market Intel); only a dispatcher edits/deletes.
    match /lane_intel/{id} {
      allow read:           if memberRead(resource);
      allow create:         if memberNew(request);
      allow update, delete: if ownDoc(resource);
    }

    // ---- shared reference data: members read, dispatcher writes ----
    match /safe_parking/{id} {
      allow read:   if memberRead(resource);
      allow create: if ownNew(request);
      allow update, delete: if ownDoc(resource);
    }
    match /vehicles/{id} {
      allow read:   if memberRead(resource);
      allow create: if ownNew(request);
      allow update, delete: if ownDoc(resource);
    }
    match /fleet_drivers/{id} {
      allow read:   if memberRead(resource);
      allow create: if ownNew(request);
      allow update, delete: if ownDoc(resource);
    }
    match /hos_status/{id} {
      allow read:   if memberRead(resource);
      allow create: if ownNew(request);
      allow update, delete: if ownDoc(resource);
    }

    // ---- carrier intake packets (PUBLIC submit) ----
    // The intake form at ?intake=<orgId> is filled by carriers with no login,
    // so create is open — but every submission must carry an orgId + a name,
    // and the dispatcher reviews each one before importing. Reads are scoped to
    // the owning workspace.
    match /carrier_packets/{id} {
      allow create: if request.resource.data.orgId is string
                    && request.resource.data.orgId.size() > 0
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200;
      allow read:           if isSuper() || (isDispatcher() && resource.data.orgId == myOrg());
      allow update, delete: if isSuper() || (isDispatcher() && resource.data.orgId == myOrg());
    }

    // ---- crash-course email leads (PUBLIC submit from the marketing site) ----
    // Anyone can sign up (open create with a valid-looking email); only the
    // super-admin reads/manages the list.
    match /course_leads/{id} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 200;
      allow read, update, delete: if isSuper();
    }

    match /dispatcher_leads/{id} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 200
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200;
      allow read, update, delete: if isSuper();
    }

    // Crash-course progress, keyed by the learner's email. The public course
    // page upserts each learner's own row (create/update with a valid email);
    // only the super-admin reads the roster. Same open-write posture as
    // course_leads — it's marketing telemetry, not sensitive workspace data.
    match /course_progress/{id} {
      allow create, update: if request.resource.data.email is string
                            && request.resource.data.email.size() > 3
                            && request.resource.data.email.size() < 200;
      allow read, delete: if isSuper();
    }

    // ---- signed agreements (APPEND-ONLY legal record) ----
    // Every e-signature writes a record here that NOBODY can edit or delete
    // from the client (not the carrier, not the dispatcher). Amended terms
    // mean a NEW signature — the old record stays. Super-admin retains
    // console-level control for legal/GDPR requests.
    match /signed_agreements/{id} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && memberNew(request)
                    && request.resource.data.signedName is string
                    && request.resource.data.signedName.size() > 0
                    && request.resource.data.textSnapshot is string;
      allow read:   if isSuper()
                    || (signedIn() && resource.data.uid == request.auth.uid)
                    || ownDoc(resource);
      allow update, delete: if isSuper();
    }

    // ---- CRM / network (dispatcher's brokers + carrier leads) ----
    match /crm_contacts/{id} {
      allow read:           if ownDoc(resource);
      allow create:         if ownNew(request);
      allow update, delete: if ownDoc(resource);
    }

    // ---- digital vault documents ----
    // A carrier owns their own docs (uid); the dispatcher manages the org's.
    // Deletion is by archive (an update), so no client delete for carriers.
    match /vault_docs/{id} {
      allow read:   if (signedIn() && resource.data.uid == request.auth.uid) || ownDoc(resource);
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid && memberNew(request)) || ownNew(request);
      allow update: if (signedIn() && resource.data.uid == request.auth.uid) || ownDoc(resource);
      allow delete: if ownDoc(resource);
    }

    // ---- outbound mail queue (Trigger Email extension) ----
    // A dispatcher queues welcome emails by creating docs here; the Firebase
    // "Trigger Email from Firestore" extension delivers them server-side (it
    // bypasses these rules), so clients get create-only and nothing else.
    //
    // Every mail doc must be stamped with the sender's own uid and their
    // workspace's orgId. This ties each queued email to a real dispatcher (so
    // it's auditable and can't be spoofed as another workspace), stops plain
    // carriers from sending at all, and keeps the queue unreadable. (Firestore
    // rules can't query users-by-email, so the recipient list itself can only
    // be fully constrained server-side; a Cloud Function is the next step if
    // stricter recipient control is ever needed.)
    match /mail/{id} {
      allow create: if isSuper()
                    || (isDispatcher()
                        && request.resource.data.senderUid == request.auth.uid
                        && request.resource.data.orgId == myOrg());
      allow read, update, delete: if false;
    }

    // ---- workspaces registry ----
    // Any workspace member (dispatcher OR their drivers) can read their own org
    // doc (e.g. to dial the dispatch phone). Provisioning/removal stays super-
    // admin; the workspace's own dispatcher may update its settings (phone, etc.).
    match /orgs/{id} {
      allow read:          if isSuper() || (signedIn() && id == myOrg());
      allow create, delete: if isSuper();
      // A dispatcher may only touch their own operational settings (dispatch
      // phone, company display name, carrier-agreement text, VIP services
      // menu) — not orgType, ownerUid/ownerEmail, or config, which are
      // business-relationship fields the super-admin sets.
      allow update:        if isSuper() || (isDispatcher() && id == myOrg()
                              && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['dispatchPhone', 'name', 'agreementText', 'lpoaText', 'vipMenu']));
    }
  }
}
